# Sentinel Node Tester (Solana) — environment
# Copy to .env and fill in. Never commit .env.

# ─── Server (same variables as the Cosmos tester) ────────────────────────────
PORT=3001
# 127.0.0.1 = local only (default). A non-loopback host refuses to start without ADMIN_TOKEN.
LISTEN_HOST=127.0.0.1
# Admin gate (Bearer token or /admin/login cookie; writes also need X-Admin-Request: 1).
# Empty = single-user local mode. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=
# PUBLIC_MODE=true serves public.html at / and refuses to start without ADMIN_TOKEN.
PUBLIC_MODE=false
ADMIN_PATH=/admin
# Let /api/public/test/start run the continuous loop that feeds /live (paid sessions).
ALLOW_PUBLIC_TEST=false
# Public loop in subscription mode (body {mode:'subscription'}): the plan it tests.
# Solana meaning: Plan PDA, Subscription PDA, Provider PDA.
# PUBLIC_TEST_PLAN_ID=
# PUBLIC_TEST_SUB_ID=
# PUBLIC_TEST_SUB_GRANTER=
# ENABLE_HSTS=true   # only behind TLS
# Admin session cookie is Secure by default; true allows it over plain http on a non-localhost host.
# INSECURE_COOKIE=false
# Where audit.db and the run files live (default ./results).
# DATA_DIR=

# ─── Solana ──────────────────────────────────────────────────────────────────
SOLANA_NETWORK=devnet
# Comma-separated RPC pool, first = preferred. Put a dedicated endpoint (Helius etc.) first;
# public devnet rate-limits getProgramAccounts. Client containers use the first entry.
SOLANA_RPC_URLS=https://api.devnet.solana.com
DVPN_PROGRAM_ID=J52dyXW3a6mkatvrQct3fo6dA9vqUtcsdBt5gGqrTBXs
DVPN_MINT=Hen2LVP6KooGaXEvdSyCHWghsEY4gLLn7wix8z6zHFSa

# ─── Tester wallet ───────────────────────────────────────────────────────────
# solana-keygen JSON key file (64-byte array). Pays every voucher channel, receives the
# refunds, signs the report memos. Keep it outside the repo. (Replaces the Cosmos MNEMONIC.)
TEST_KEYFILE=

# ─── Client container (every paid session runs here, never on the host) ─────
DVPND_IMAGE=snt-tester/dvpnd:devnet-cf4c372-ddv2
# Lab nodes that advertise 127.0.0.1 / a LAN address: <nodePda>=<host>[:port], comma-separated.
# NODE_URI_OVERRIDES=6AaXvhWpFDMf8FimxSb2Tb3bKcgPmbZxj4Tdtb31nP8F=172.20.52.21:8443
# Plan runs read a plan's node roster from its provider's API. Lab providers that
# advertise 127.0.0.1: <providerPda>=https://<host>:<port>, comma-separated.
# PROVIDER_API_OVERRIDES=CdxxwuftRrZVj9EmtLFwNj9yVAgB6WNhC5KVdCH7HLV5=https://127.0.0.1:19443
# Seconds one client container may run before it is killed.
# CLIENT_TIMEOUT_SEC=360

# ─── Audit ───────────────────────────────────────────────────────────────────
# MB pulled through each tunnel.
TEST_MB=10
# GB the client prepays per session (its signed voucher; node minimum is 100 MB).
GIGABYTES_PER_NODE=1
# Max nodes per run, 0 = every live listing.
MAX_NODES=0
# Delay between node tests (chain writes stay ≥ 7 s apart).
NODE_DELAY_MS=7000
# Speed sources: Cloudflare first ({bytes} = size), then ranged reads of these large files (comma-separated).
# SPEED_URL=https://speed.cloudflare.com/__down?bytes={bytes}
# SPEED_FALLBACK_URLS=https://proof.ovh.net/files/100Mb.dat,http://speedtest.tele2.net/100MB.zip
# Speed method. DEFAULT = steady (lib/speed-method.js, evidence in test/bwlab/ and
# docs/BANDWIDTH-TRUTH.md): verified per-test bytes from our own origin (scripts/bwlab/origin.mjs),
# 4 time-bounded streams, steady-state median. The node test and the baseline both use it; the
# classic download above still runs beside it and is the fallback when steady cannot run.
# SPEED_METHOD=classic selects the old single 10 MB download. Unset/missing origin settings with
# steady selected = classic fallback + a warning (`node cli.js speed` / `doctor` show it).
SPEED_METHOD=steady
SPEED_ORIGIN=https://<origin-host>[:port]
SPEED_PIN=sha256//<base64 SPKI hash of the origin key>
SPEED_SECRET_FILE=<file holding the origin secret, outside the repo>
# SPEED_STREAMS=4
# SPEED_SECONDS=10
# SPEED_BUDGET_MB=600
# Reuse a steady baseline this long; the pipeline asks for one before every node.
# SPEED_BASELINE_TTL_SEC=1800
# In-tunnel connectivity / latency probe.
# CONNECTIVITY_URL=https://www.google.com/generate_204
# Tester internet check; all down = the run pauses instead of failing nodes.
# INTERNET_CHECK_URLS=https://www.google.com,https://1.1.1.1,https://www.cloudflare.com
# DNS the client containers use at boot (IPs, comma-separated); the admin DNS selector overrides it.
# DNS_SERVERS=1.1.1.1,1.0.0.1
# Pause the run when the wallet holds less than this (base units; default = one channel's escrow floor).
# MIN_CHANNEL_BALANCE_BASE=
# Background refund sweep interval (closes matured test channels, withdraws escrow).
# SWEEP_EVERY_MS=3600000
